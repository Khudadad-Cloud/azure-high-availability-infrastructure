```hcl
# Frontend Subnet for Azure Infrastructure

resource "azurerm_subnet" "frontend" {
  name                 = "frontend-subnet"
  resource_group_name  = var.resource_group_name
  virtual_network_name = azurerm_virtual_network.main.name
  address_prefixes     = ["10.0.1.0/24"]
}

# Output Frontend Subnet Details

output "frontend_subnet_name" {
  description = "Name of the frontend subnet"
  value       = azurerm_subnet.frontend.name
}

output "frontend_subnet_address_prefix" {
  description = "Frontend subnet CIDR range"
  value       = azurerm_subnet.frontend.address_prefixes
}
```
